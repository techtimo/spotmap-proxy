# Required
ADMIN_KEY=change-me-to-a-strong-random-secret

# Optional
PORT=8080
DATABASE_PATH=/data/spotmap-proxy.sqlite

# Optional — if set, enforces HTTP Basic Auth on POST /zoleo
ZOLEO_BASIC_AUTH_USER=
ZOLEO_BASIC_AUTH_PASS=

# AIS vessel tracking (optional — leave blank to disable)
AIS_API_KEY=
